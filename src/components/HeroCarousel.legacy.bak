'use client';

import React, { useState, useEffect, useRef, useCallback } from 'react';
import Image from 'next/image';
import { ChevronLeft, ChevronRight, User } from 'lucide-react';
import PlayStationIcon from '@/components/icons/PlayStationIcon';
import { useCart } from '@/context/CartContext';

import Slide1FeelTheGame from './hero/Slide1FeelTheGame';
import Slide2Colorways from './hero/Slide2Colorways';
import Slide3CollectorSeries from './hero/Slide3CollectorSeries';
import Slide4DigitalArchive from './hero/Slide4DigitalArchive';
import Slide5GamesMarket from './hero/Slide5GamesMarket';

const SLIDES = [
  { id: 1, name: 'PS5 Feel The Game', isDark: true },
  { id: 2, name: 'DualSense Colorways', isDark: false },
  { id: 3, name: 'Collector Series', isDark: true },
  { id: 4, name: '2,000+ Game Pre-loads', isDark: true },
  { id: 5, name: 'Games Market & Discs', isDark: false }
];

const AUTO_ADVANCE_MS = 5000;

export default function HeroCarousel() {
  const { setIsCartOpen, cartCount } = useCart();
  const [currentSlide, setCurrentSlide] = useState(0);
  const [isPaused, setIsPaused] = useState(false);
  const [progress, setProgress] = useState(0);
  const progressIntervalRef = useRef<NodeJS.Timeout | null>(null);

  const activeThemeIsDark = SLIDES[currentSlide].isDark;

  const nextSlide = useCallback(() => {
    setCurrentSlide((prev) => (prev + 1) % SLIDES.length);
    setProgress(0);
  }, []);

  const prevSlide = useCallback(() => {
    setCurrentSlide((prev) => (prev - 1 + SLIDES.length) % SLIDES.length);
    setProgress(0);
  }, []);

  const goToSlide = (index: number) => {
    setCurrentSlide(index);
    setProgress(0);
  };

  // 5-second synchronized progress bar & auto-advancement
  useEffect(() => {
    if (isPaused) {
      if (progressIntervalRef.current) clearInterval(progressIntervalRef.current);
      return;
    }

    const stepMs = 50;
    const increment = (stepMs / AUTO_ADVANCE_MS) * 100;

    progressIntervalRef.current = setInterval(() => {
      setProgress((prev) => {
        if (prev >= 100) {
          nextSlide();
          return 0;
        }
        return prev + increment;
      });
    }, stepMs);

    return () => {
      if (progressIntervalRef.current) clearInterval(progressIntervalRef.current);
    };
  }, [isPaused, nextSlide]);

  const scrollToSection = (id: string) => {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  };

  return (
    <div className="w-full relative overflow-hidden bg-[#060913]">
      
      {/* ========================================================
          1. UNIVERSAL AUTO-INVERTING FLOATING PILL NAVBAR
          Inverts dynamically based on the current slide's lighting
         ======================================================== */}
      <div className="absolute top-5 sm:top-6 inset-x-0 flex justify-center z-40 pointer-events-none px-4">
        <header
          className={`pointer-events-auto inline-flex items-center space-x-3.5 sm:space-x-7 px-4 sm:px-7 py-2 sm:py-2.5 rounded-full transition-all duration-500 shadow-2xl font-sans ${
            activeThemeIsDark
              ? 'bg-white/95 text-slate-900 border border-white/80 shadow-black/50'
              : 'bg-slate-950/95 text-white border border-slate-800 shadow-slate-950/40'
          }`}
        >
          <button 
            onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}
            className={`text-[10px] sm:text-[11px] font-bold uppercase tracking-wider transition-colors ${
              activeThemeIsDark ? 'text-slate-900 hover:text-blue-600' : 'text-white hover:text-cyan-400'
            }`}
          >
            HOME
          </button>
          <button 
            onClick={() => scrollToSection('storefront')}
            className={`text-[10px] sm:text-[11px] font-bold uppercase tracking-wider transition-colors ${
              activeThemeIsDark ? 'text-slate-900 hover:text-blue-600' : 'text-white hover:text-cyan-400'
            }`}
          >
            GAMES
          </button>
          <button 
            onClick={() => scrollToSection('storefront')}
            className={`text-[10px] sm:text-[11px] font-bold uppercase tracking-wider transition-colors ${
              activeThemeIsDark ? 'text-slate-900 hover:text-blue-600' : 'text-white hover:text-cyan-400'
            }`}
          >
            ACCESSORIES
          </button>

          {/* Center Official PlayStation Logo */}
          <div className="px-1 sm:px-2 flex items-center justify-center">
            <PlayStationIcon className={`w-5 h-5 sm:w-6 sm:h-6 stroke-none ${activeThemeIsDark ? 'text-slate-950' : 'text-white'}`} />
          </div>

          <button 
            onClick={() => scrollToSection('storefront')}
            className={`text-[10px] sm:text-[11px] font-bold uppercase tracking-wider transition-colors ${
              activeThemeIsDark ? 'text-slate-900 hover:text-blue-600' : 'text-white hover:text-cyan-400'
            }`}
          >
            EXPLORE
          </button>
          <button 
            onClick={() => scrollToSection('repairs')}
            className={`text-[10px] sm:text-[11px] font-bold uppercase tracking-wider transition-colors ${
              activeThemeIsDark ? 'text-slate-900 hover:text-blue-600' : 'text-white hover:text-cyan-400'
            }`}
          >
            SUPPORT
          </button>

          {/* User Profile / Cart Trigger */}
          <button 
            onClick={() => setIsCartOpen(true)}
            aria-label="User Profile & Cart"
            className={`relative w-6 h-6 sm:w-7 sm:h-7 rounded-full border flex items-center justify-center transition-all ${
              activeThemeIsDark
                ? 'border-slate-300 hover:border-slate-800 hover:bg-slate-100 text-slate-800'
                : 'border-slate-700 hover:border-white hover:bg-white/10 text-white'
            }`}
          >
            <User className="w-3.5 h-3.5 stroke-[2.2]" />
            {cartCount > 0 && (
              <span className="absolute -top-1 -right-1 w-3.5 h-3.5 bg-blue-600 text-white text-[8px] font-black rounded-full flex items-center justify-center shadow-xs">
                {cartCount}
              </span>
            )}
          </button>
        </header>
      </div>

      {/* ========================================================
          2. CAROUSEL STAGE CONTAINER (Pause-on-Hover Engine)
         ======================================================== */}
      <div 
        onMouseEnter={() => setIsPaused(true)}
        onMouseLeave={() => setIsPaused(false)}
        onTouchStart={() => setIsPaused(true)}
        onTouchEnd={() => setIsPaused(false)}
        role="region"
        aria-roledescription="carousel"
        aria-label="Nas Tech Master Gaming Hero Carousel"
        className="relative w-full overflow-hidden"
      >
        
        {/* Slide 1: PlayStation 5 "Feel the Game" Master Stage */}
        <div className={`transition-opacity duration-700 ease-in-out ${currentSlide === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}>
          <Slide1FeelTheGame />
        </div>

        {/* Slide 2: DualSense Colorways Studio Showcase */}
        <div className={`transition-opacity duration-700 ease-in-out ${currentSlide === 1 ? 'block opacity-100' : 'hidden opacity-0'}`}>
          <Slide2Colorways />
        </div>

        {/* Slide 3: Limited Edition Collector Series */}
        <div className={`transition-opacity duration-700 ease-in-out ${currentSlide === 2 ? 'block opacity-100' : 'hidden opacity-0'}`}>
          <Slide3CollectorSeries />
        </div>

        {/* Slide 4: Over 2,000 Games Direct-to-Drive Hub */}
        <div className={`transition-opacity duration-700 ease-in-out ${currentSlide === 3 ? 'block opacity-100' : 'hidden opacity-0'}`}>
          <Slide4DigitalArchive />
        </div>

        {/* Slide 5: Games Market & Trending Releases */}
        <div className={`transition-opacity duration-700 ease-in-out ${currentSlide === 4 ? 'block opacity-100' : 'hidden opacity-0'}`}>
          <Slide5GamesMarket />
        </div>

        {/* ----------------------------------------------------
            MANUAL NAVIGATION CONTROLS: PREV / NEXT CHEVRONS
           ---------------------------------------------------- */}
        <button
          onClick={prevSlide}
          aria-label="Previous Hero Slide"
          className={`absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-11 sm:h-11 rounded-full flex items-center justify-center transition-all backdrop-blur-md shadow-xl active:scale-95 ${
            activeThemeIsDark
              ? 'bg-black/30 hover:bg-black/60 text-white border border-white/20'
              : 'bg-white/80 hover:bg-white text-slate-900 border border-slate-300'
          }`}
        >
          <ChevronLeft className="w-5 h-5 sm:w-6 sm:h-6" />
        </button>

        <button
          onClick={nextSlide}
          aria-label="Next Hero Slide"
          className={`absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-11 sm:h-11 rounded-full flex items-center justify-center transition-all backdrop-blur-md shadow-xl active:scale-95 ${
            activeThemeIsDark
              ? 'bg-black/30 hover:bg-black/60 text-white border border-white/20'
              : 'bg-white/80 hover:bg-white text-slate-900 border border-slate-300'
          }`}
        >
          <ChevronRight className="w-5 h-5 sm:w-6 sm:h-6" />
        </button>

        {/* ----------------------------------------------------
            SLIDE SELECTOR DOCK WITH 5-SECOND PROGRESS BARS
           ---------------------------------------------------- */}
        <div className="absolute bottom-3 sm:bottom-4 inset-x-0 flex flex-col items-center justify-center z-30 pointer-events-none">
          <div className="pointer-events-auto flex items-center space-x-2 sm:space-x-3 px-3.5 py-1.5 rounded-full bg-black/40 backdrop-blur-xl border border-white/10 shadow-2xl">
            {SLIDES.map((slide, idx) => (
              <button
                key={slide.id}
                onClick={() => goToSlide(idx)}
                aria-label={`Go to slide ${idx + 1}: ${slide.name}`}
                className="group relative flex items-center space-x-1.5 focus:outline-none py-1"
              >
                {/* Indicator Pill */}
                <div
                  className={`relative h-2 rounded-full overflow-hidden transition-all duration-300 ${
                    currentSlide === idx ? 'w-12 sm:w-16 bg-white/30' : 'w-2.5 sm:w-3 bg-white/20 hover:bg-white/40'
                  }`}
                >
                  {/* Active 5-second progress fill */}
                  {currentSlide === idx && (
                    <div
                      className="absolute inset-y-0 left-0 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full transition-all duration-75"
                      style={{ width: `${progress}%` }}
                    />
                  )}
                </div>

                {/* Micro Number */}
                <span className={`text-[9px] font-black transition-colors ${currentSlide === idx ? 'text-white' : 'text-slate-400 hidden sm:inline'}`}>
                  0{idx + 1}
                </span>
              </button>
            ))}
          </div>
        </div>

      </div>

      {/* ========================================================
          3. SECTION 02: PLAYSTATION 5 LANDING PAGE CONCEPT OVERVIEW
          (Preserved below hero carousel from reference)
         ======================================================== */}
      <section id="concept-overview" className="w-full bg-white text-slate-900 border-t border-slate-200/80">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div className="flex items-center space-x-3.5">
              <PlayStationIcon className="w-8 h-8 text-slate-950 shrink-0" />
              <h2 className="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-950 font-sans">
                PlayStation 5 Landing Page Concept
              </h2>
            </div>
            <p className="text-xs sm:text-sm text-slate-500 max-w-md font-medium leading-relaxed font-sans">
              A futuristic landing page concept inspired by the PlayStation 5 visual language. The design combines bold typography, iconic silhouettes, and immersive hardware mechanics.
            </p>
          </div>

          <div className="mt-8 pt-4 border-t border-slate-200 flex items-center justify-between text-xs font-bold text-slate-400 uppercase tracking-widest font-sans">
            <span>Landing Page</span>
            <span>01 / PROJECT OVERVIEW</span>
          </div>

          <div className="mt-8 relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 aspect-[16/9] sm:aspect-[21/9]">
            <Image
              src="/assets/hero/concept_card_cropped.png"
              alt="PlayStation 5 Cinematic Controller Interface Overview"
              fill
              unoptimized
              priority
              className="object-cover"
            />
          </div>
        </div>
      </section>

    </div>
  );
}
